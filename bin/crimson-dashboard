#!/usr/bin/env bash
# Crimson Desktop launcher: runs crimson.dashboard from the project directory.
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/crimson-desktop/env" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/crimson-desktop/env"
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "${CRIMSON_PYTHON:-python3}" -m crimson.dashboard "$@"
